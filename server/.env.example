PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster-host/appointment_platform
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173
AI_PROVIDER=provider-name
AI_MODEL=model-name
AI_API_KEY=replace-with-provider-key